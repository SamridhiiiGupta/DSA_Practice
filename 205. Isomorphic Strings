class Solution {
public:
    bool isIsomorphic(string s, string t) {

        unordered_map<char, char> mapST;
        unordered_map<char, char> mapTS;

        for(int i = 0; i < s.length(); i++) {

            char a = s[i];
            char b = t[i];

            // Check s -> t mapping
            if(mapST.count(a) && mapST[a] != b) {
                return false;
            }

            // Check t -> s mapping
            if(mapTS.count(b) && mapTS[b] != a) {
                return false;
            }

            // Create the mappings
            mapST[a] = b;
            mapTS[b] = a;
        }

        return true;
    }
};