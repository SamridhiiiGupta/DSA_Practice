select Department, Employee, salary
from (
    select 
    d.name as Department ,
    e.name as Employee,
    e.salary as salary,
    DENSE_RANK() OVER(
        PARTITION BY e.departmentId
        ORDER BY e.salary desc
    ) as salary_rank
    from Employee e
    join Department d
    on e.departmentId = d.id
)t
where salary_rank <=3;