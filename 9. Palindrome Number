class Solution {
public:
    bool isPalindrome(int x) {
        long long reverseNum =0;
        int dup = x;
        while(x>0){
            int lastdigit = x%10;
            reverseNum = (reverseNum * 10) + lastdigit;
            x = x/10;
        }
        if(dup == reverseNum) return true;
        else return false;
    }
};