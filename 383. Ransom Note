class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {

        int count[26] = {0};

        // Count characters available in magazine
        for(char c : magazine) {
            count[c - 'a']++;
        }

        // Use characters required by ransomNote
        for(char c : ransomNote) {

            if(count[c - 'a'] == 0) {
                return false;
            }

            count[c - 'a']--;
        }

        return true;
    }
};