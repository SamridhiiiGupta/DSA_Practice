class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        int n = nums.size();
        vector<int> answer(n);
        answer[0] =1;
        //stoore prefix product
        for(int i=1;i<n;i++){
            answer[i] = answer[i-1] * nums[i-1];
        }
        int rightProduct =1;
        //multiply with suffix products
        for(int i=n-1;i>=0;i--){
            answer[i] *= rightProduct;
            rightProduct *= nums[i];
        }
        return answer;
    }
};