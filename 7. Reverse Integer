class Solution {
public:
    int reverse(int x) {
        int reverseNum=0;
        while(x!=0){
            int lastdigit = x%10;

             // overflow check
            if (reverseNum > INT_MAX / 10 || 
               (reverseNum == INT_MAX / 10 && lastdigit > 7)) {
                return 0;
            }

            // underflow check
            if (reverseNum < INT_MIN / 10 || 
               (reverseNum == INT_MIN / 10 && lastdigit < -8)) {
                return 0;
            }

            reverseNum = (reverseNum *10) + lastdigit;
            x=x/10;
        }
        return reverseNum;
    }
};