select 
round(avg(case when d.order_date = d.customer_pref_delivery_date then 1 else 0 end) * 100, 2)
as immediate_percentage 
from Delivery d
join (select customer_id , min(order_date) as first_order_date
from Delivery
group by customer_id)
first_order

on d.customer_id = first_order.customer_id
and d.order_date = first_order.first_order_date;